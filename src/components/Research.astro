---
const areas = [
  { icon: "⬡", title: "Dark Matter & Dark Energy", desc: "Probing the nature of invisible components constituting 95% of the universe through direct detection signatures and cosmological structure formation." },
  { icon: "◎", title: "Cosmic Inflation", desc: "Studying the rapid early-universe expansion, primordial gravitational waves, and the seeds of cosmic large-scale structure." },
  { icon: "⬟", title: "Neutrino Physics", desc: "Exploring neutrino masses, mixing, and their pivotal role in Big Bang nucleosynthesis and cosmological evolution." },
  { icon: "⟳", title: "Gravitational Waves", desc: "Investigating stochastic gravitational wave backgrounds and their connections to early-universe phase transitions and new physics." },
  { icon: "✦", title: "Big Bang Nucleosynthesis", desc: "Computing light element abundances and constraining new physics through precision primordial nucleosynthesis calculations." },
  { icon: "⌬", title: "Astroparticle Phenomenology", desc: "Connecting high-energy theoretical models with astrophysical and cosmological observations, from CMB to gamma-ray signals." },
];
---
<section id="research">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Research Areas</p>
      <h2 class="section-title">What we work on</h2>
      <div class="divider"></div>
      <p class="section-subtitle">
        Our research bridges particle physics and cosmology, tackling open questions about
        the early universe, dark sector, and high-energy astrophysical phenomena.
      </p>
    </div>
    <div class="research-grid">
      {areas.map((area, i) => (
        <div class="research-card" style={`animation-delay: ${i * 0.08}s`}>
          <span class="card-icon">{area.icon}</span>
          <h3>{area.title}</h3>
          <p>{area.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #research { background: var(--bg); }

  .section-header {
    margin-bottom: 56px;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .research-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 36px 28px;
    transition: border-color 0.25s, transform 0.25s, background 0.25s;
    position: relative;
    overflow: hidden;
  }

  .research-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .research-card:hover {
    border-color: rgba(201,135,45,0.3);
    transform: translateY(-4px);
    background: var(--bg3);
  }

  .research-card:hover::before {
    opacity: 1;
  }

  .card-icon {
    display: block;
    font-size: 1.8rem;
    color: var(--accent);
    margin-bottom: 20px;
    line-height: 1;
  }

  .research-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .research-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  @media (max-width: 900px) {
    .research-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .research-grid { grid-template-columns: 1fr; }
  }
</style>
