---
const news = [
  { date: 'Nov 2024', tag: 'Award', title: 'Lab member wins Best Poster Award at the Korean Physical Society Annual Meeting', desc: 'PhD student received recognition for outstanding research on primordial gravitational wave signatures.' },
  { date: 'Sep 2024', tag: 'Publication', title: 'New paper on CMB constraints published in Physical Review D', desc: 'Our latest work on dark matter constraints from CMB anisotropy power spectra has been accepted in PRD.' },
  { date: 'Aug 2024', tag: 'Event', title: 'TAPPC hosts international workshop on early-universe cosmology', desc: 'The lab organized a week-long workshop bringing together researchers from Korea, Japan, and Europe.' },
];
---
<section id="news">
  <div class="container">
    <p class="section-label">News</p>
    <h2 class="section-title">Latest Updates</h2>
    <div class="divider"></div>

    <div class="news-grid">
      {news.map(n => (
        <div class="news-card">
          <div class="news-header">
            <span class="news-date">{n.date}</span>
            <span class="news-tag">{n.tag}</span>
          </div>
          <h3 class="news-title">{n.title}</h3>
          <p class="news-desc">{n.desc}</p>
          <a href="#" class="news-more">Read more →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #news { background: var(--bg); }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .news-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.25s, transform 0.25s;
  }

  .news-card:hover {
    border-color: rgba(201,135,45,0.3);
    transform: translateY(-4px);
  }

  .news-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .news-date {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .news-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    background: rgba(74,144,217,0.1);
    color: var(--accent2);
    border: 1px solid rgba(74,144,217,0.25);
    border-radius: 2px;
    text-transform: uppercase;
  }

  .news-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
  }

  .news-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.7;
    flex: 1;
  }

  .news-more {
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 500;
    transition: gap 0.2s;
  }

  .news-more:hover { opacity: 0.8; }

  @media (max-width: 900px) {
    .news-grid { grid-template-columns: 1fr; }
  }
</style>
