---
---

<section id="home" class="hero-section">
  <div class="hero-bg"></div>
  <div class="stars" id="stars"></div>
  <div class="hero-inner container">
    <div class="hero-eyebrow">Sungkyunkwan University · Department of Physics</div>
    <h1>Theoretical <em>Astro-Particle</em><br>Physics &amp; Cosmology</h1>
    <p class="hero-subtitle">천체입자물리학 및 우주론 이론 연구실</p>
    <p class="hero-desc">
      We explore the fundamental nature of the universe — from dark matter and neutrinos
      to cosmic inflation and gravitational waves — using the tools of theoretical physics,
      field theory, and computational cosmology.
    </p>
    <div class="btn-group">
      <a href="#research" class="btn btn-primary">Our Research</a>
      <a href="#publications" class="btn btn-outline">Publications</a>
    </div>
  </div>
  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 64px 48px 0;
    background: var(--white);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 70% 40%, #e8eff9 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 20% 80%, #f5f0e8 0%, transparent 50%);
    pointer-events: none;
  }

  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .star {
    position: absolute;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    animation: twinkle var(--d, 4s) var(--delay, 0s) ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.8); }
    50% { opacity: var(--op, 0.3); transform: scale(1); }
  }

  .hero-inner {
    position: relative;
    padding: 0;
  }

  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Inter', sans-serif;
  }

  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    font-family: 'EB Garamond', serif;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    font-weight: 400;
    color: var(--heading);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-subtitle {
    font-family: 'EB Garamond', serif;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--muted);
    margin-bottom: 36px;
    font-style: italic;
    letter-spacing: 0.01em;
  }

  .hero-desc {
    max-width: 560px;
    font-size: 0.9375rem;
    color: var(--body);
    line-height: 1.8;
    margin-bottom: 48px;
  }

  .btn-group {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: 'Inter', sans-serif;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--border), transparent);
    animation: scrollDown 1.6s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
</style>

<script>
  const starsEl = document.getElementById('stars');
  if (starsEl) {
    for (let i = 0; i < 60; i++) {
      const s = document.createElement('div');
      s.className = 'star';
      const size = Math.random() * 2.5 + 0.8;
      s.style.cssText = `
        width:${size}px; height:${size}px;
        left:${Math.random()*100}%;
        top:${Math.random()*100}%;
        --d:${(Math.random()*4+3).toFixed(1)}s;
        --delay:${(Math.random()*5).toFixed(1)}s;
        --op:${(Math.random()*0.25+0.08).toFixed(2)};
      `;
      starsEl.appendChild(s);
    }
  }
</script>
