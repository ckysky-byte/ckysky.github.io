---
---
<section id="about" style="background: var(--bg2);">
  <div class="container">
    <div class="about-grid">
      <div class="about-left">
        <p class="section-label">About the Lab</p>
        <h2 class="section-title">Bridging the cosmos<br/>and the quantum world</h2>
        <div class="divider"></div>
        <p class="about-text">
          The TAPPC group at Sungkyunkwan University investigates theoretical problems at the
          intersection of particle astrophysics, cosmology, and quantum field theory. Our work spans
          high-energy theoretical frameworks, early-universe thermodynamics, and the statistical
          signatures of new physics in astrophysical observations.
        </p>
        <p class="about-text" style="margin-top:16px;">
          We are part of the Department of Physics at Sungkyunkwan University (SKKU) in Suwon, Korea.
          Our group maintains active collaborations with leading research institutions worldwide.
        </p>
        <div class="stats-row">
          <div class="stat">
            <span class="stat-num">15<span class="stat-plus">+</span></span>
            <span class="stat-label">Publications</span>
          </div>
          <div class="stat">
            <span class="stat-num">6</span>
            <span class="stat-label">Lab Members</span>
          </div>
          <div class="stat">
            <span class="stat-num">5<span class="stat-plus">+</span></span>
            <span class="stat-label">Collaborations</span>
          </div>
          <div class="stat">
            <span class="stat-num">2020</span>
            <span class="stat-label">Founded</span>
          </div>
        </div>
      </div>
      <div class="about-right">
        <div class="cosmos-visual">
          <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="cg1" cx="50%" cy="50%">
                <stop offset="0%" stop-color="#c9872d" stop-opacity="0.6"/>
                <stop offset="40%" stop-color="#4a90d9" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="transparent"/>
              </radialGradient>
              <radialGradient id="cg2" cx="50%" cy="50%">
                <stop offset="0%" stop-color="#fff" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#c9872d" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <!-- Background glow -->
            <circle cx="200" cy="200" r="180" fill="url(#cg1)" opacity="0.4"/>
            <!-- Orbital rings -->
            <ellipse cx="200" cy="200" rx="150" ry="60" fill="none" stroke="rgba(74,144,217,0.2)" stroke-width="1"/>
            <ellipse cx="200" cy="200" rx="150" ry="60" fill="none" stroke="rgba(201,135,45,0.2)" stroke-width="1" transform="rotate(60 200 200)"/>
            <ellipse cx="200" cy="200" rx="150" ry="60" fill="none" stroke="rgba(74,144,217,0.15)" stroke-width="1" transform="rotate(120 200 200)"/>
            <!-- Web lines -->
            <g stroke="rgba(201,135,45,0.25)" stroke-width="0.8">
              <line x1="200" y1="200" x2="80" y2="100"/>
              <line x1="200" y1="200" x2="320" y2="100"/>
              <line x1="200" y1="200" x2="50" y2="250"/>
              <line x1="200" y1="200" x2="350" y2="250"/>
              <line x1="200" y1="200" x2="130" y2="360"/>
              <line x1="200" y1="200" x2="270" y2="360"/>
            </g>
            <!-- Nodes -->
            <circle cx="80" cy="100" r="5" fill="#4a90d9" opacity="0.7"/>
            <circle cx="320" cy="100" r="4" fill="#c9872d" opacity="0.8"/>
            <circle cx="50" cy="250" r="6" fill="#4a90d9" opacity="0.6"/>
            <circle cx="350" cy="250" r="4" fill="#c9872d" opacity="0.7"/>
            <circle cx="130" cy="360" r="5" fill="#4a90d9" opacity="0.5"/>
            <circle cx="270" cy="360" r="3" fill="#c9872d" opacity="0.6"/>
            <!-- Center -->
            <circle cx="200" cy="200" r="18" fill="url(#cg2)"/>
            <circle cx="200" cy="200" r="6" fill="#fff" opacity="0.95"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-text {
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 0.98rem;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-num {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }

  .stat-plus {
    color: var(--accent);
    font-size: 1.4rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .cosmos-visual {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; gap: 40px; }
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .about-right { order: -1; }
    .cosmos-visual { max-width: 260px; }
  }
</style>
