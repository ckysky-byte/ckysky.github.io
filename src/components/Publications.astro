---
const pubs = [
  {
    year: '2023',
    title: 'Non-thermal WIMPy Baryogenesis with Primordial Black Hole',
    authors: 'K. Y. Choi, J. Kim and E. Lkhagvadorj',
    journal: 'Journal of Cosmology and Astroparticle Physics',
    vol: 'arXiv:2309.16122 [hep-ph], accepted',
    badge: 'JCAP',
    arxiv: 'https://arxiv.org/abs/2309.16122'
  },
  {
    year: '2023',
    title: 'Light cold dark matter from non-thermal decay',
    authors: 'K. Y. Choi, J. O. Gong, J. Joh, W. I. Park and O. Seto',
    journal: 'Physics Letters B',
    vol: '845, 138126',
    badge: 'PLB',
    arxiv: 'https://arxiv.org/abs/2304.07462'
  },
  {
    year: '2023',
    title: 'Probing sterile neutrino dark matter in the PTOLEMY-like experiment',
    authors: 'K. Y. Choi, E. Lkhagvadorj and S. M. Yoo',
    journal: 'Journal of Cosmology and Astroparticle Physics',
    vol: '06 (2023) 021',
    badge: 'JCAP',
    arxiv: 'https://arxiv.org/abs/2212.14192'
  },
  {
    year: '2023',
    title: 'Cored dark matter halos in the cosmic neutrino background',
    authors: 'W. Cho, K. Y. Choi and H. J. Kim',
    journal: 'Journal of Cosmology and Astroparticle Physics',
    vol: '07 (2023) 013',
    badge: 'JCAP',
    arxiv: 'https://arxiv.org/abs/2204.01431'
  },
  {
    year: '2022',
    title: 'Potential reconstruction from general power spectrum in single-field inflation',
    authors: 'K. Y. Choi, J. O. Gong, S. b. Kang and R. N. Raveendran',
    journal: 'Journal of Cosmology and Astroparticle Physics',
    vol: '01 (2022) 012',
    badge: 'JCAP',
    arxiv: 'https://arxiv.org/abs/2109.14241'
  },
];
---
<section id="publications">
  <div class="container">
    <p class="section-label">Publications</p>
    <h2 class="section-title">Selected Papers</h2>
    <div class="divider"></div>

    <div class="pub-list">
      {pubs.map((p, i) => (
        <div class="pub-item">
          <div class="pub-index">{String(i + 1).padStart(2, '0')}</div>
          <div class="pub-body">
            <div class="pub-meta">
              <span class="pub-year">{p.year}</span>
              <span class="pub-badge">{p.badge}</span>
            </div>
            <h3 class="pub-title">{p.title}</h3>
            <p class="pub-authors">{p.authors}</p>
            <p class="pub-journal"><em>{p.journal}</em> {p.vol}</p>
          </div>
          <a href={p.arxiv} target="_blank" rel="noopener" class="pub-link" title="View on arXiv">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      ))}
    </div>

    <div class="pub-footer">
      <a href="https://inspirehep.net/authors?sort=mostrecent&size=25&page=1&q=Ki-Young%20Choi&ui-citation-summary=true" target="_blank" rel="noopener" class="btn-ghost">
        View All Publications on InspireHEP →
      </a>
    </div>
  </div>
</section>

<style>
  #publications { background: var(--bg2); }

  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pub-item {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 24px;
    align-items: start;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
  }

  .pub-item:first-child { border-top: 1px solid var(--border); }

  .pub-index {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    padding-top: 4px;
    letter-spacing: 0.05em;
  }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .pub-year {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .pub-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    background: rgba(201,135,45,0.15);
    color: var(--accent);
    border: 1px solid rgba(201,135,45,0.3);
    border-radius: 2px;
  }

  .pub-title {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .pub-authors {
    font-size: 0.84rem;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .pub-journal {
    font-size: 0.82rem;
    color: rgba(136,145,170,0.7);
  }

  .pub-link {
    padding-top: 4px;
    color: var(--text-muted);
    transition: color 0.2s, transform 0.2s;
    display: block;
  }

  .pub-link:hover {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .pub-footer {
    margin-top: 48px;
    text-align: center;
  }

  .btn-ghost {
    display: inline-block;
    padding: 12px 32px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 2px;
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .pub-item { grid-template-columns: 36px 1fr; }
    .pub-link { display: none; }
  }
</style>
