---
---
<section id="contact" style="background: var(--bg2);">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left">
        <p class="section-label">Contact</p>
        <h2 class="section-title">Get in Touch</h2>
        <div class="divider"></div>
        <p class="section-subtitle">
          Interested in joining the TAPPC group or collaborating with us?
          We welcome inquiries from motivated students and researchers.
        </p>

        <div class="contact-info">
          <div class="ci">
            <span class="ci-label">Address</span>
            <p>Department of Physics<br/>Sungkyunkwan University<br/>2066 Seobu-ro, Jangan-gu<br/>Suwon, Gyeonggi-do 16419, Korea</p>
          </div>
          <div class="ci">
            <span class="ci-label">Email</span>
            <a href="mailto:kiyoungchoi@skku.edu">kiyoungchoi@skku.edu</a>
          </div>
          <div class="ci">
            <span class="ci-label">Phone</span>
            <p>(+82)-(0)31-290-5907</p>
          </div>
          <div class="ci">
            <span class="ci-label">Office</span>
            <p>Natural Sciences Building 1, Room 31303</p>
          </div>
        </div>
      </div>

      <div class="contact-right">
        <div class="join-box">
          <h3>Open Positions</h3>
          <p>We are always looking for talented students at all levels (MS, PhD) with strong backgrounds in theoretical physics, cosmology, or related fields.</p>
          <ul class="positions">
            <li>
              <span class="pos-badge">MS/PhD</span>
              <span>Graduate Research Assistant in Dark Matter Theory</span>
            </li>
            <li>
              <span class="pos-badge">Postdoc</span>
              <span>Postdoctoral Researcher in Astroparticle Phenomenology</span>
            </li>
          </ul>
          <a href="mailto:kiyoungchoi@skku.edu" class="btn-join">Apply via Email</a>
        </div>

        <div class="map-box">
          <div class="map-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Sungkyunkwan University, Suwon
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }

  .contact-info {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ci-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .ci p, .ci a {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .ci a:hover { color: var(--accent); }

  .join-box {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 36px;
    margin-bottom: 24px;
  }

  .join-box h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .join-box > p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .positions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .positions li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .pos-badge {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 8px;
    background: rgba(201,135,45,0.1);
    color: var(--accent);
    border: 1px solid rgba(201,135,45,0.3);
    border-radius: 2px;
    letter-spacing: 0.06em;
    margin-top: 2px;
  }

  .btn-join {
    display: inline-block;
    padding: 12px 28px;
    background: var(--accent);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 2px;
    transition: background 0.2s;
  }

  .btn-join:hover { background: #e09b3a; }

  .map-box {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 4px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .map-box::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(201,135,45,0.1) 0%, transparent 70%);
  }

  .map-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    position: relative;
    z-index: 1;
  }

  .map-label svg { color: var(--accent); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
